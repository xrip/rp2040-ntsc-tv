{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "rp2040",
      "displayName": "RP2040 / Cortex-M0+",
      "description": "Build for Raspberry Pi Pico with RP2040",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-rp2040",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "PICO_BOARD": "pico",
        "PICO_PLATFORM": "rp2040",
        "PICOTOOL_FETCH_FROM_GIT_PATH": "$env{TEMP}/picotool-2.3.0-x64-win",
        "PICO_NO_UF2": "OFF",
        "VGA": "ON",
        "NTSC_TV": "ON",
        "HDMI": "OFF",
        "TFT": "OFF",
        "NTSC_LOW_RAM": "OFF",
        "NTSC_USE_SCRATCH_Y": "OFF"
      }
    },
    {
      "name": "rp2350",
      "displayName": "RP2350 / Cortex-M33",
      "description": "Build for Raspberry Pi Pico 2 with RP2350 Arm cores",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-rp2350",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "PICO_BOARD": "pico2",
        "PICO_PLATFORM": "rp2350-arm-s",
        "PICOTOOL_FETCH_FROM_GIT_PATH": "$env{TEMP}/picotool-2.3.0-x64-win",
        "PICO_NO_UF2": "OFF",
        "PICO_NO_COPRO_DIS": "ON",
        "VGA": "ON",
        "NTSC_TV": "ON",
        "HDMI": "OFF",
        "TFT": "OFF",
        "NTSC_LOW_RAM": "OFF",
        "NTSC_USE_SCRATCH_Y": "OFF"
      }
    },
    {
      "name": "rp2040-hdmi",
      "displayName": "RP2040 / HDMI",
      "inherits": "rp2040",
      "binaryDir": "${sourceDir}/cmake-build-rp2040-hdmi",
      "cacheVariables": {
        "VGA": "OFF",
        "NTSC_TV": "OFF",
        "HDMI": "ON"
      }
    },
    {
      "name": "rp2350-hdmi",
      "displayName": "RP2350 / HDMI",
      "inherits": "rp2350",
      "binaryDir": "${sourceDir}/cmake-build-rp2350-hdmi",
      "cacheVariables": {
        "VGA": "OFF",
        "NTSC_TV": "OFF",
        "HDMI": "ON"
      }
    },
    {
      "name": "rp2040-tft",
      "displayName": "RP2040 / TFT",
      "inherits": "rp2040",
      "binaryDir": "${sourceDir}/cmake-build-rp2040-tft",
      "cacheVariables": {
        "VGA": "OFF",
        "NTSC_TV": "OFF",
        "TFT": "ON"
      }
    },
    {
      "name": "rp2040-tft-ntsc",
      "displayName": "RP2040 / TFT + NTSC",
      "inherits": "rp2040",
      "binaryDir": "${sourceDir}/cmake-build-rp2040-tft-ntsc",
      "cacheVariables": {
        "VGA": "OFF",
        "NTSC_TV": "ON",
        "TFT": "ON"
      }
    },
    {
      "name": "rp2350-tft",
      "displayName": "RP2350 / TFT",
      "inherits": "rp2350",
      "binaryDir": "${sourceDir}/cmake-build-rp2350-tft",
      "cacheVariables": {
        "VGA": "OFF",
        "NTSC_TV": "OFF",
        "TFT": "ON"
      }
    },
    {
      "name": "rp2350-tft-ntsc",
      "displayName": "RP2350 / TFT + NTSC",
      "inherits": "rp2350",
      "binaryDir": "${sourceDir}/cmake-build-rp2350-tft-ntsc",
      "cacheVariables": {
        "VGA": "OFF",
        "NTSC_TV": "ON",
        "TFT": "ON"
      }
    }
  ]
}
